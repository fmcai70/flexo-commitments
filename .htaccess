# ActionRegister on Hostinger (LiteSpeed/Apache).

RewriteEngine On

# Always use HTTPS.
# (Not for /.well-known/, which the free SSL certificate is verified through.)
RewriteCond %{HTTPS} off
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# The Git deploy copies the whole repository; keep notes and git internals off the public website.
RewriteRule ^(\.git|\.github)(/|$) - [F,L]
RewriteRule \.(md|sql|ts|patch|sh|ps1)$ - [F,L]
RewriteRule ^(supabase|migration)(/|$) - [F,L]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]

<IfModule mod_headers.c>
  # Check for a new version on every visit.
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

AddType application/manifest+json .webmanifest
Options -Indexes
